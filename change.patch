+def test_cross_instance_reuse_tokens_are_reusable_not_miss():
+    args = _args(enable_shared=True)
+    pool = SharedPrefixKvCachePool(KvCacheEngine(args.cache_capacity, args.block_size, args.kv_cache_size_per_token))
